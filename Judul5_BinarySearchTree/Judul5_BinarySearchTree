class Node:
    def __init__(self, tinggi, nama):
        self.tinggi = tinggi
        self.nama = nama
        self.left = None
        self.right = None

class BSTBalita:
    def __init__(self):
        self.root = None

    def insert_node(self, root, tinggi, nama):
        if root is None:
            return Node(tinggi, nama)
        if tinggi < root.tinggi:
            root.left = self.insert_node(root.left, tinggi, nama)
        elif tinggi > root.tinggi:
            root.right = self.insert_node(root.right, tinggi, nama)
        return root

    def insert(self, tinggi, nama):
        self.root = self.insert_node(self.root, tinggi, nama)

    def search_nama(self, root, nama):
        if root is None:
            return None
        if root.nama.lower() == nama.lower():
            return root
        kiri = self.search_nama(root.left, nama)
        if kiri:
            return kiri
        return self.search_nama(root.right, nama)

    def search(self, nama):
        return self.search_nama(self.root, nama)

    def inorder(self, root):
        if root is None:
            return
        self.inorder(root.left)
        print(root.nama, "-", root.tinggi, "cm", end=" ")
        self.inorder(root.right)

    def preorder(self, root):
        if root is None:
            return
        print(root.nama, "-", root.tinggi, "cm", end=" ")
        self.preorder(root.left)
        self.preorder(root.right)

    def postorder(self, root):
        if root is None:
            return
        self.postorder(root.left)
        self.postorder(root.right)
        print(root.nama, "-", root.tinggi, "cm", end=" ")

    def find_min(self, root):
        if root is None:
            return None
        current = root
        while current.left is not None:
            current = current.left
        return current

    def find_max(self, root):
        if root is None:
            return None
        current = root
        while current.right is not None:
            current = root.right
        return current

    def count_nodes(self, root):
        if root is None:
            return 0
        return 1 + self.count_nodes(root.left) + self.count_nodes(root.right)

    def sum_nodes(self, root):
        if root is None:
            return 0
        return root.tinggi + self.sum_nodes(root.left) + self.sum_nodes(root.right)

def main():
    bst = BSTBalita()
    pilih = 0
    while pilih != 10:
        print("\n=== Sistem Pendataan Tinggi Badan Balita ===")
        print("1. Tambah Data Balita")
        print("2. Cari Data Balita Berdasarkan Nama")
        print("3. Tampilkan data berdasarkan urutan tinggi terendah ke tertinggi")
        print("4. Tampilkan data berdasarkan urutan dari data pertama ke terakhir")
        print("5. Tampilkan data berdasarkan urutan dari data terakhir ke pertama")
        print("6. Tampilkan data balita terpendek")
        print("7. Tampilkan data balita tertinggi")
        print("8. Tampilkan jumlah data balita")
        print("9. Tampilkan total tinggi seluruh balita")
        print("10. Keluar dari sitem")
        try:
            pilih = int(input("Pilih menu: "))
        except ValueError:
            print("Input tidak valid!")
            continue
        if pilih == 1:
            try:
                nama = input("Nama balita: ")
                tinggi = int(input("Tinggi badan (cm): "))
                bst.insert(tinggi, nama)
                print("Data berhasil ditambahkan")
            except ValueError:
                print("Input tidak valid!")
        elif pilih == 2:
            nama = input("Masukkan nama balita yang dicari: ")
            hasil = bst.search(nama)

            if hasil:
                print("Ditemukan:", hasil.nama, "-", hasil.tinggi, "cm")
            else:
                print("Data tidak ditemukan")
        elif pilih == 3:
            print("Data balita berdasarkan tinggi terendah ke tertinggi:")
            bst.inorder(bst.root)
            print()
        elif pilih == 4:
            print("Data balita berdasarkan data pertama ke terakhir:")
            bst.preorder(bst.root)
            print()
        elif pilih == 5:
            print("Data balita berdasarkan data terakhir ke pertama:")
            bst.postorder(bst.root)
            print()
        elif pilih == 6:
            min_node = bst.find_min(bst.root)
            if min_node:
                print("Balita terpendek:", min_node.nama, "-", min_node.tinggi, "cm")
        elif pilih == 7:
            max_node = bst.find_max(bst.root)
            if max_node:
                print("Balita tertinggi:", max_node.nama, "-", max_node.tinggi, "cm")
        elif pilih == 8:
            print("Jumlah data balita:", bst.count_nodes(bst.root))
        elif pilih == 9:
            print("Total tinggi seluruh balita:", bst.sum_nodes(bst.root), "cm")
        elif pilih == 10:
            print("Program selesai")
            break
        else:
            print("Pilihan tidak valid!")

if __name__ == "__main__":
    main()
